# Canonical external REC URL for metadata and production browser-origin checks.
# Set at build/deploy time; do not use the reverse proxy's internal address.
NEXT_PUBLIC_SITE_URL=https://rec.nrep.ug

NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_COUPONS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_REGISTRANTS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_CONFERENCES_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_PROGRAMS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_PROGRAM_TIME_BLOCKS_COLLECTION_ID=rec_program_time_blocks
NEXT_PUBLIC_APPWRITE_SPONSOR_CATEGORIES_COLLECTION_ID=rec_sponsor_categories
NEXT_PUBLIC_APPWRITE_SPONSORS_COLLECTION_ID=rec_sponsors
NEXT_PUBLIC_NREP_LOGO_URL=

APPWRITE_API_KEY=
# Optional server-side overrides; blank values fall back to the matching public IDs above.
APPWRITE_DATABASE_ID=
APPWRITE_COUPONS_COLLECTION_ID=
APPWRITE_REGISTRANTS_COLLECTION_ID=
APPWRITE_CONFERENCES_COLLECTION_ID=
APPWRITE_LOCKS_COLLECTION_ID=rec_registration_locks
APPWRITE_VERIFICATIONS_COLLECTION_ID=rec_registration_verifications
# Keep the token secret stable. A blank value falls back to APPWRITE_API_KEY.
REGISTRATION_TOKEN_SECRET=
REGISTRATION_SERVER_BASE_URL=https://server.nrep.ug
REGISTRATION_EMAIL_API_PATH=/api/rec/send-reg-confirmation-email
REGISTRATION_OTP_EMAIL_API_PATH=/api/rec/send-registration-otp-email
# Scanner, badges, exhibitors, media and rapporteur reporting all use this backend.
# Local development: http://localhost:3000, with the HR portal running on that port.
HR_PORTAL_BASE_URL=https://hr.nrep.ug
# Local development only. Both apps must opt in and share a random 32+ character secret.
REC_SCANNER_DEV_LOGIN_ENABLED=false
REC_SCANNER_DEV_LOGIN_SECRET=
REC_REGISTRATION_SYNC_SECRET=
