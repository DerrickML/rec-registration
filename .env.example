# Canonical external REC URL for metadata and production browser-origin checks.
# Set at build/deploy time; do not use the reverse proxy's internal address.
NEXT_PUBLIC_SITE_URL=https://rec.nrep.ug

NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_COUPONS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_REGISTRANTS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_CONFERENCES_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID=
NEXT_PUBLIC_APPWRITE_PROGRAMS_COLLECTION_ID=
NEXT_PUBLIC_NREP_LOGO_URL=

APPWRITE_API_KEY=
APPWRITE_LOCKS_COLLECTION_ID=rec_registration_locks
APPWRITE_VERIFICATIONS_COLLECTION_ID=rec_registration_verifications
HR_PORTAL_BASE_URL=https://hr.nrep.ug
# Local development only. Both apps must opt in and share a random 32+ character secret.
REC_SCANNER_DEV_LOGIN_ENABLED=false
REC_SCANNER_DEV_LOGIN_SECRET=
REC_REGISTRATION_SYNC_SECRET=
